# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local example:   postgresql://postgres:password@localhost:5432/classflow
# Railway/Render:  provided automatically as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/classflow

# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Secret key to protect your API endpoints (any random string works)
MY_API_KEY=your_secret_api_key_here

# How often the watcher syncs (in seconds). Default: 3600 (1 hour)
POLL_INTERVAL_SECONDS=3600

# Set to "true" to enable Flask debug mode (never use in production)
FLASK_DEBUG=false

# Flask API port (default 5001; macOS often reserves 5000 for AirPlay)
PORT=5001

# Paths to Google OAuth files (defaults shown, change if needed)
TOKEN_PATH=token.json
CREDENTIALS_PATH=credentials.json
